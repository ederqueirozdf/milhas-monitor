FROM registry.access.redhat.com/ubi9/python-312:latest

USER 0
RUN mkdir -p /data && chown -R 1001:0 /data && chmod -R g+rwX /data
USER 1001

WORKDIR /opt/app-root/src
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=1001:0 milhas ./milhas
COPY --chown=1001:0 config.yaml .

ENV MILHAS_DB=/data/milhas.db \
    CONFIG_PATH=/opt/app-root/src/config.yaml \
    PYTHONUNBUFFERED=1

EXPOSE 8000
CMD ["uvicorn", "milhas.main:app", "--host", "0.0.0.0", "--port", "8000"]
