# Token que o skill do OpenClaw usa para chamar a API (gere com: openssl rand -hex 32)
MILHAS_API_TOKEN=

# Seu bot do Telegram (o mesmo do OpenClaw serve — aqui só enviamos mensagens)
TELEGRAM_BOT_TOKEN=
# Seu chat_id (veja o README para descobrir)
TELEGRAM_CHAT_ID=

# Opcional: preços em dinheiro dos trechos via Google Flights (https://serpapi.com)
# Sem ela, os trechos são monitorados só pelos posts dos blogs.
SERPAPI_KEY=

LOG_LEVEL=INFO
MILHAS_HTTP_PORT=8090
