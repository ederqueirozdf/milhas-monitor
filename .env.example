# Token que o skill do OpenClaw usa para chamar a API (gere com: openssl rand -hex 32)
MILHAS_API_TOKEN=

# Seu bot do Telegram (o mesmo do OpenClaw serve — aqui só enviamos mensagens)
TELEGRAM_BOT_TOKEN=
# Seu chat_id (veja o README para descobrir)
TELEGRAM_CHAT_ID=

# Opcional: preços em dinheiro dos trechos via Google Flights (https://serpapi.com)
# Sem ela, os trechos são monitorados só pelos posts dos blogs.
SERPAPI_KEY=

# Rede default do compose do OpenClaw (docker network ls | grep openclaw)
OPENCLAW_NETWORK=openclaw-milhas_default

# Traefik (docker-compose.traefik.yml) → https://milhas-monitor.srv1767526.hstgr.cloud
COMPOSE_PROJECT_NAME=milhas-monitor
TRAEFIK_HOST=srv1767526.hstgr.cloud

LOG_LEVEL=INFO
MILHAS_HTTP_PORT=8090

# Opcional: disponibilidade de resgate em milhas (Smiles, Azul e outros 23 programas) e Explorar
# Chave em https://seats.aero/settings, aba API (plano Pro: 1.000 chamadas/dia, uso não comercial)
SEATS_AERO_API_KEY=
